#!/usr/bin/env nix-shell
#!nix-shell -i bash -p python313 python313Packages.pyqt6 python313Packages.pymupdf python313Packages.pyqt6-webengine python313Packages.qtconsole python313Packages.ipykernel libxcb-cursor ttyd

# Qt's xcb platform plugin dlopen()s libxcb-cursor.so.0 at runtime rather than linking
# it in at build time, so having libxcb-cursor as a nix-shell buildInput above isn't
# enough on its own — it still needs to be on LD_LIBRARY_PATH for that dlopen() to find
# it, otherwise Qt fails with "xcb-cursor0 or libxcb-cursor0 is needed" even though the
# package is right there. nix-shell already resolves its store path into NIX_LDFLAGS
# (as -L/nix/store/.../lib), so pull every -L path out of that instead of re-resolving
# it separately.
export LD_LIBRARY_PATH="$(echo "$NIX_LDFLAGS" | tr ' ' '\n' | sed -n 's/^-L//p' | tr '\n' ':')${LD_LIBRARY_PATH}"

# Prefer xcb whenever an X11 display is actually reachable — this covers every
# previously-validated setup, including Plasma's own Wayland session, which runs xcb
# apps fine via XWayland. Deliberately NOT switching to native wayland just because
# $WAYLAND_DISPLAY is set (i.e. for every Wayland session in general): a prior
# investigation (see ai/issues.md) found the QtWebEngine GPU-compositor crash bug
# reproduces under native wayland too — if anything faster than under xcb — so
# blanket-preferring wayland would trade a working default for a differently-broken
# one. Only fall back to wayland when xcb genuinely has nothing to connect to (no
# $DISPLAY at all — e.g. a minimal Wayland compositor like Niri that doesn't start
# XWayland by default), where xcb was previously a hard "could not connect to
# display" failure and wayland is the only platform with any chance of working.
if [ -n "$DISPLAY" ]; then
  export QT_QPA_PLATFORM=xcb
else
  export QT_QPA_PLATFORM=wayland
fi

exec "$(dirname "$0")/projectflow.py" "$@"
